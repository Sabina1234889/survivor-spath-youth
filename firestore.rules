rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow public read and write access for all collections used in the application
    match /inbox/{docId} {
      allow read, write: if true;
    }
    match /complaints/{docId} {
      allow read, write: if true;
    }
    match /events/{docId} {
      allow read, write: if true;
    }
    match /event_attendees/{docId} {
      allow read, write: if true;
    }
    match /team/{docId} {
      allow read, write: if true;
    }
    match /partners/{docId} {
      allow read, write: if true;
    }
    match /programs/{docId} {
      allow read, write: if true;
    }
    match /impact_stories/{docId} {
      allow read, write: if true;
    }
    match /users/{docId} {
      allow read, write: if true;
    }

    // Default catch-all rule
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
